# Supabase shared pooler (IPv4). Direct connection is for IPv6.
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

# Full URL for clients that expect a single string
DATABASE_URL=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Supabase (Auth API + Postgres). Keys are in Dashboard → Settings → API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Canonical web origin used in Supabase Auth email redirects (must be allowlisted there).
PUBLIC_APP_URL=http://localhost:5173

# Environment variables
NODE_ENV=development
PORT=8000